{
  "name": "lighttable-build",
  "version": "0.9.0",
  "private": true,
  "description": "Build tooling for Light Table's ClojureScript and main-process sources.",
  "devDependencies": {
    "shadow-cljs": "^3.4.4",
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1",
    "electron": "43.2.0"
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "watch:main": "tsc -p tsconfig.json --watch",
    "build:window": "tsc -p tsconfig.window.json",
    "build:cljs": "shadow-cljs release app worker && node script/place-plugins.js && npm run --silent place:user-plugin",
    "place:user-plugin": "node -e \"require('fs').copyFileSync('deploy/core/lighttable/user.js','deploy/core/User/user_compiled.js')\"",
    "build:plugins": "tsc -p plugins/HelloTS/tsconfig.json && node script/place-plugins.js"
  }
}
