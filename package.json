{
  "name": "lighttable-build",
  "version": "0.10.0",
  "private": true,
  "description": "Build tooling for Light Table's ClojureScript and main-process sources.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "electron": "43.2.0",
    "eslint": "^10.8.0",
    "shadow-cljs": "^3.4.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "watch:main": "tsc -p tsconfig.json --watch",
    "build:window": "tsc -p tsconfig.window.json",
    "build:worker": "tsc -p tsconfig.worker.json",
    "build:browser": "tsc -p tsconfig.browser.json",
    "build:ts": "node script/build-ts.mts",
    "build:cljs": "node script/build-cljs.mts",
    "build:plugins": "node script/build-plugins.mts",
    "deps:plugins": "node script/install-plugin-deps.mts",
    "lint:cljs": "node script/lint-cljs.mts",
    "lint:js": "eslint script src-electron src-window src-worker src-browser test-electron test-e2e",
    "typecheck": "node script/typecheck.mts",
    "audit": "node script/audit.mts",
    "doctor": "node script/doctor.mts",
    "test": "node script/test.mts",
    "test:cljs": "shadow-cljs compile test && node target/test.js",
    "test:electron": "node --test \"test-electron/**/*.test.ts\"",
    "test:e2e": "script/e2e.sh",
    "docs:api": "node script/gen-api-docs.mts",
    "docs:check": "node script/gen-api-docs.mts --check",
    "check": "node script/check.mts",
    "tools": "node script/fetch-clj-kondo.mts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7"
  }
}
