(ns lt.objs.plugins.node-modules
  "Node's modules, as far as a plugin in the window still needs them.

  Each of these is Node-shaped on the outside and a bridge capability or a
  browser package on the inside. What decides whether a plugin gets one is
  [[lt.objs.plugins.require-shim]]; this is only the modules.

  Two kinds live here, and the difference matters more than it looks:

  **Bridge-backed** — `fs`, `net`, `path`, `os`, `util`. These reach the
  system, so they cross to the preload and are gated on a capability. Objects
  they hand back are handles: what crosses is functions over something that
  stays put.

  **Bundled** — `buffer`, and anything like it later. These reach nothing;
  they are arithmetic over bytes. Serving them from the window rather than the
  preload is not only cheaper, it is what makes chains work. An nREPL client
  takes a socket's data, concatenates it, and decodes it; if `Buffer` lived in
  the preload the concatenated value would cross twice and arrive as something
  else both times. In the window it is one world throughout."
  (:require ["bencode" :as node-bencode]
            ["buffer" :as node-buffer]
            ["events" :as node-events]
            [clojure.string :as string]
            [lt.objs.plugins.capabilities :as caps]
            [lt.util.bridge :as bridge]))

(defn- emitter
  "The EventEmitter surface plugins use on a socket or a server.

  `events` maps an event name to the handle registration that feeds it, so an
  event Light Table does not carry is refused at `on` rather than silently
  never firing. Returns the object; the caller adds the methods that are not
  events."
  [events]
  (let [listeners (atom {})
        this (js-obj)]
    (doseq [[event register] events]
      (register (fn [& args] (doseq [f (get @listeners event)] (apply f args)))))
    (doto this
      (aset "on" (fn [event f]
                   (when-not (contains? events event)
                     (throw (js/Error. (str "Light Table does not raise '" event "' here"))))
                   (swap! listeners update event (fnil conj []) f)
                   this))
      (aset "once" (fn [event f]
                     (let [wrapper (atom nil)]
                       (reset! wrapper (fn [& args]
                                         (swap! listeners update event
                                                #(vec (remove #{@wrapper} %)))
                                         (apply f args)))
                       ((aget this "on") event @wrapper))))
      (aset "addListener" (aget this "on"))
      (aset "removeAllListeners" (fn [] (reset! listeners {}) this))
      (aset "setMaxListeners" (fn [] this)))))

(defn- socket
  "A Node-shaped socket over a bridge socket handle."
  [^js handle]
  (doto (emitter {"connect" #(.onConnect handle %)
                  "data" #(.onData handle %)
                  "close" #(.onClose handle %)
                  ;; Node hands an Error, and plugins read .code off it.
                  "error" #(.onError handle (fn [message code]
                                              (% (doto (js/Error. message)
                                                   (aset "code" code)))))})
    (aset "write" (fn [data] (.write handle data) true))
    (aset "end" (fn [] (.end handle)))
    (aset "destroy" (fn [] (.destroy handle)))
    (aset "setNoDelay" (fn [] nil))
    (aset "setKeepAlive" (fn [] nil))))

(defn- server
  "A Node-shaped `net.Server` over a bridge server handle.

  Plugins reach for one as often to find a free port as to serve on one: ask
  to listen, and being refused is the answer."
  [^js handle]
  (doto (emitter {"listening" #(.onListening handle %)
                  "connection" #(.onConnection handle (fn [s] (% (socket s))))
                  "close" #(.onClose handle %)
                  "error" #(.onError handle (fn [message code]
                                              (% (doto (js/Error. message)
                                                   (aset "code" code)))))})
    (aset "address" (fn [] #js {:port (.port handle)}))
    (aset "close" (fn [] (.close handle)))))

(defn- net-module []
  ;; net.connect(port, host) and net.connect({port, host}) are both in use;
  ;; plugins were written against whichever they found first.
  (let [connect (fn [port host]
                  (let [[port host] (if (object? port)
                                      [(.-port port) (or (.-host port) "127.0.0.1")]
                                      [port (or host "127.0.0.1")])]
                    (socket (.connect bridge/sockets port host))))
        ;; net.Server is constructed rather than called, and listens later, so
        ;; the bridge server it wraps cannot exist until then.
        Server (fn []
                 (this-as this
                   (let [pending (atom nil)
                         delegate (atom nil)]
                     (doto this
                       (aset "listen"
                             (fn [port callback]
                               (let [s (server (.listen bridge/sockets (or port 0)))]
                                 (reset! delegate s)
                                 (doseq [[event f] @pending] (.on s event f))
                                 (when callback (.on s "listening" callback))
                                 this)))
                       (aset "on" (fn [event f]
                                    (if-let [s @delegate]
                                      (.on s event f)
                                      (swap! pending (fnil conj []) [event f]))
                                    this))
                       (aset "close" (fn [] (some-> ^js @delegate (.close)) this))
                       (aset "address" (fn [] (some-> ^js @delegate (.address))))))))]
    #js {:connect connect
         :createConnection connect
         :Server Server
         :createServer (fn [on-connection]
                         (let [s (Server.)]
                           (when on-connection (.on s "connection" on-connection))
                           s))}))

(defn- fs-module []
  (let [f bridge/files]
    #js {:existsSync #(.existsSync f %)
         :readFileSync (fn [path & _] (.readFileSync f path))
         :writeFileSync (fn [path content & _] (.writeFileSync f path content))
         :appendFileSync (fn [path content & _] (.appendFileSync f path content))
         :mkdirSync #(.mkdirSync f %)
         :readdirSync #(.readdirSync f %)
         :realpathSync #(.realpathSync f %)
         :renameSync #(.renameSync f %1 %2)
         ;; A plain object rather than an fs.Stats: Stats keeps isDirectory and
         ;; isFile on a prototype, and a prototype does not cross.
         :statSync (fn [path]
                     (when-let [s (.statSync f path)]
                       #js {:isDirectory #(.-isDirectory s)
                            :isFile #(.-isFile s)
                            :size (.-size s)
                            :mode (.-mode s)
                            :mtimeMs (.-mtimeMs s)}))}))

(defn- path-module []
  (let [p bridge/path]
    #js {:join (fn [& parts] (.apply (.-join p) p (into-array parts)))
         :resolve (fn [& parts] (.apply (.-resolve p) p (into-array parts)))
         :relative #(.relative p %1 %2)
         :dirname #(.dirname p %)
         :basename (fn [path ext] (.basename p path ext))
         :extname #(.extname p %)
         :isAbsolute #(.isAbsolute p %)
         :sep (.-sep p)}))

(defn- os-module []
  (let [env (.env bridge/host)]
    #js {:EOL (.-EOL bridge/os)
         :platform (fn [] (:platform bridge/app-info))
         :homedir (fn [] (or (.-HOME env) (.-USERPROFILE env)))
         :tmpdir (fn [] (or (.-TMPDIR env) (.-TEMP env) "/tmp"))}))

(defn- shelljs-module []
  ;; Two functions, because two functions is all any plugin was found to use —
  ;; the Clojure plugin calls `pwd` and both flagships call `which` to locate a
  ;; java or node binary. shelljs itself is a shell in a library, and serving
  ;; the whole of it would mean serving a shell.
  (let [p bridge/path
        f bridge/files
        executable? (fn [path]
                      (when-let [s (.statSync f path)]
                        (and (.-isFile s) (pos? (bit-and (.-mode s) 0111)))))]
    #js {:pwd (fn [] (.cwd bridge/host))
         :which (fn [command]
                  (let [env (.env bridge/host)
                        sep (if (= "win32" (:platform bridge/app-info)) ";" ":")
                        exts (if (= "win32" (:platform bridge/app-info))
                               ["" ".exe" ".cmd" ".bat"]
                               [""])]
                    (first (for [dir (string/split (or (.-PATH env) "") (re-pattern sep))
                                 ext exts
                                 :let [candidate (.join p dir (str command ext))]
                                 :when (and (seq dir) (executable? candidate))]
                             candidate))))}))

(defn- util-module []
  ;; inspect and inherits. The rest of `util` is promisify and type predicates,
  ;; which a plugin can get from the language now; these two it cannot.
  #js {:inspect (fn [value depth] (.inspect bridge/host value (or depth 2)))
       :inherits (fn [^js child ^js parent]
                   (set! (.-super_ child) parent)
                   (set! (.-prototype child) (js/Object.create (.-prototype parent)
                                                               #js {:constructor
                                                                    #js {:value child
                                                                         :writable true
                                                                         :configurable true}})))})

(def modules
  "Module name to `[capability factory]`, the table
  [[lt.objs.plugins.require-shim/requirer]] serves from. A nil capability is a
  module that reaches nothing.

  Not every module Node has — every module a plugin was found to need. A name
  that is not here is refused and says so, which is a better answer than a
  facade missing the one method the plugin wanted."
  {"net" [:network net-module]
   "fs" [:files fs-module]
   "path" [:files path-module]
   "os" [:files os-module]
   "util" [nil util-module]
   "buffer" [nil (fn [] node-buffer)]
   "events" [nil (fn [] node-events)]
   ;; Not builtins, but packages Light Table ships and plugins reach through
   ;; lt.util.load/node-module rather than vendoring their own. Bundled for the
   ;; same reason `buffer` is: bencode decodes bytes a socket delivered, and
   ;; the two have to be the same world.
   "bencode" [nil (fn [] node-bencode)]
   "shelljs" [:files shelljs-module]})

(assert (every? #(or (nil? %) (caps/known %)) (map first (vals modules)))
        "every module capability has to be one a manifest can declare")

(defn globals
  "Node globals a plugin written against Node expects to find.

  Not modules, so `require` never sees them, and the window loses them along
  with everything else. They are few and each is small:

  `Buffer`  — the bundled one. bencode reaches for it globally rather than
              requiring it, and it is not alone in that.
  `global`  — the window, which is what it means here.
  `setImmediate` — a macrotask, so `setTimeout(f, 0)` rather than
              `queueMicrotask`, which would run before the browser gets a turn
              and defeat the point of yielding.
  `process` — the three fields plugin code was found to read, over the host
              capability. Not the real one: no `exit`, no `binding`, and
              `mainModule` is null rather than a lie about a module system the
              window does not have."
  []
  {"Buffer" (.-Buffer node-buffer)
   "global" js/window
   "setImmediate" (fn [f & args] (js/setTimeout #(apply f args) 0))
   "clearImmediate" (fn [id] (js/clearTimeout id))
   "process" #js {:env (.env bridge/host)
                  :platform (:platform bridge/app-info)
                  :versions (.versions bridge/host)
                  :nextTick (fn [f & args] (js/queueMicrotask #(apply f args)))
                  :cwd (fn [] (.cwd bridge/host))
                  :mainModule nil
                  :argv (clj->js (:argv bridge/app-info))}})
