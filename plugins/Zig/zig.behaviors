{;; Zig, as data. No code in this plugin.
 ;;
 ;; zls also formats, using zig fmt.
 ;;
 ;; There is no CodeMirror mode for Zig, so a .zig file has a language server
 ;; and no highlighting until a grammar is added.
 :+ {:lsp.client [(:lt.objs.editor.lsp/language-servers
                   [{:tags [:editor.zig]
                     :language-id "zig"
                     :root ["build.zig" "build.zig.zon" ".git"]
                     :command "zls"
                     :args []
                     :install "zig fetch --global zls, or your package manager"}])]}}
