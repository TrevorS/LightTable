{;; Zig, as data. No code in this plugin.
 ;;
 ;; zls also formats, using zig fmt.
 ;;
 ;; There is no CodeMirror mode for Zig and it does not need one: the
 ;; highlighting is tree-sitter's, from the grammar registered against
 ;; :editor.zig in lt.objs.editor.treesitter.
 :+ {:lsp.client [(:lt.objs.editor.lsp/language-servers
                   [{:tags [:editor.zig]
                     :language-id "zig"
                     :root ["build.zig" "build.zig.zon" ".git"]
                     :command "zls"
                     :args []
                     :install "zig fetch --global zls, or your package manager"}])]}}
