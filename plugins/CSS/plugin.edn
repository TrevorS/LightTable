{:name "CSS"
 :version "0.0.6"
 :author "Kodowa"
 :source "https://github.com/LightTable/CSS"
 :desc "CSS/SCSS language plugin for Light Table"
 :behaviors "css.behaviors"

 ;; What this plugin needs, declared rather than discovered — see
 ;; plugins/README.md.
 ;;
 ;; :files  works out a stylesheet's path relative to the connected client's,
 ;;         so that url() references still resolve once the CSS is injected
 ;;
 ;; Not :network. It sends through lt.objs.clients, which is Light Table's own
 ;; routing rather than a socket the plugin opens; the connection belongs to
 ;; whatever the editor is connected to.
 :capabilities #{:files}}
