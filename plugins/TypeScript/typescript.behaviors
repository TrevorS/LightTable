;; Behaviors for the TypeScript plugin.
;;
;; The file types for .ts, .tsx, .mts and .cts are Light Table's own —
;; deploy/settings/default/default.behaviors — because what they carry is the
;; CodeMirror mime, and that is the same question for every language the editor
;; ships. This plugin adds what comes after colouring.
;;
;; A language server is squarely after colouring, so the declaration below is
;; the plugin's rather than core's. It is also what makes the capability
;; manifest true: this plugin already declares :processes and :files, and a
;; server spawned from core would have been a process accounted to nobody.
[
 [:app :lt.objs.plugins/load-js "typescript_compiled.js"]

 ;; vtsls rather than typescript-language-server: it wraps the same extension
 ;; VS Code ships, so completion matches what most people are used to. Both
 ;; speak LSP, so swapping back is one line in user.behaviors.
 ;;
 ;; One entry per distinct :language-id. They differ — "typescript",
 ;; "typescriptreact", "javascript" — and that costs nothing, because
 ;; connections are keyed by [root command] and all three share one server.
 [:lsp.client :lt.objs.editor.lsp/language-servers
  [{:tags [:editor.typescript]
    :language-id "typescript"
    :root ["tsconfig.json" "jsconfig.json" "package.json"]
    :command "vtsls"
    :args ["--stdio"]
    :install "npm i -g @vtsls/language-server"}
   {:tags [:editor.tsx]
    :language-id "typescriptreact"
    :root ["tsconfig.json" "jsconfig.json" "package.json"]
    :command "vtsls"
    :args ["--stdio"]
    :install "npm i -g @vtsls/language-server"}
   {:tags [:editor.javascript]
    :language-id "javascript"
    :root ["tsconfig.json" "jsconfig.json" "package.json"]
    :command "vtsls"
    :args ["--stdio"]
    :install "npm i -g @vtsls/language-server"}]]
]
