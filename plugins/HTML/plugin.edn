{:name "HTML"
 :version "0.1.0"
 :author "Kodowa"
 :source "https://github.com/LightTable/HTML"
 :desc "HTML language plugin for Light Table"
 :behaviors "html.behaviors"

 ;; What this plugin needs, declared rather than discovered — see
 ;; plugins/README.md.
 ;;
 ;; Nothing. It reads the open editor, sends the result through
 ;; lt.objs.clients, and opens a browser tab inside Light Table — none of which
 ;; is a capability, which the capability report confirms rather than takes on
 ;; trust. An empty set is a claim; omitting the key would be declining to make
 ;; one.
 :capabilities #{}}
