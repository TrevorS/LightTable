;; Build config for shadow-cljs, which builds everything Light Table ships.
;; project.clj remains only for the codox API docs and builds nothing.
;;
;; deploy/core/User/src is the default user plugin. It shipped as a compiled
;; artifact that nothing rebuilt, so it drifted from the editor around it — it
;; was still calling crate.core/html years after that rename. Compiling it here
;; makes a rename in the host a build error rather than something a user
;; discovers at startup.
{:source-paths ["src" "src-gen" "test" "deploy/core/User/src" "plugins/Paredit/src"]

 :dependencies []

 :builds
 {:app
  {:target     :browser
   :output-dir "deploy/core/lighttable"
   :asset-path "."

   ;; The User plugin is a second module rather than a second build: it is
   ;; compiled against this bundle, shares its cljs.core, and is emitted as a
   ;; plain script the plugin loader can load. `npm run build:cljs` copies it
   ;; into the plugin's own directory, which is where load-js resolves from.
   :modules {:bootstrap {:entries [lt.core]}
             :user      {:entries [lt.plugins.user] :depends-on #{:bootstrap}}
             :paredit   {:entries [lt.plugins.paredit] :depends-on #{:bootstrap}}}

   ;; npm packages are bundled rather than required at runtime. The window is
   ;; losing `require` when contextIsolation goes on, so anything it needs has
   ;; to be in the bundle by then; :shadow is shadow-cljs's normal mode.
   ;; Runtime dependencies live in deploy/core/node_modules, next to what ships;
   ;; the root tree is build tooling. Shadow looks in the root by default.
   :js-options {:js-provider :shadow
                :js-package-dirs ["deploy/core/node_modules" "node_modules"]}

   :compiler-options {:optimizations  :simple
                      :pretty-print   true
                      :process-shim   false
                      ;; Light Table's plugin API is the global lt.* namespaces,
                      ;; and LightTable.html calls lt.objs.app.init() directly,
                      ;; so the bundle cannot be wrapped in a closure.
                      :output-wrapper false}}

  ;; The worker thread. Compiled rather than assembled from strings at runtime,
  ;; so its contents are visible to the compiler like everything else.
  :worker
  {:target    :node-script
   :main      lt.background.worker/main
   :output-to "deploy/core/lighttable/background/worker.js"
   :compiler-options {:optimizations :simple
                      :pretty-print  true}}

  ;; Runs under node, so only namespaces that load without a DOM or an Electron
  ;; runtime can be exercised here. Anything needing the real app is covered by
  ;; script/smoke-test.js instead.
  :test
  {:target    :node-test
   :output-to "target/test.js"
   :ns-regexp "-test$"}}}
