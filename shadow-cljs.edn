;; Build config for shadow-cljs, which builds everything Light Table ships.
;; It is the only Clojure build file here — there is no project.clj and no
;; deps.edn.
;;
;; deploy/core/User/src is the default user plugin. It shipped as a compiled
;; artifact that nothing rebuilt, so it drifted from the editor around it — it
;; was still calling crate.core/html years after that rename. Compiling it here
;; makes a rename in the host a build error rather than something a user
;; discovers at startup.
{:source-paths ["src" "src-gen" "test" "deploy/core/User/src"
                "plugins/Paredit/src" "plugins/Clojure/src"
                "plugins/Javascript/src" "plugins/CSS/src" "plugins/HTML/src"
                "plugins/Python/src"]

 :dependencies []

 ;; Closure Compiler bundles a protobuf that reads memory through
 ;; sun.misc.Unsafe, and every JDK since 24 prints four lines about it on every
 ;; compile. Nothing here can act on that — it is a transitive dependency of a
 ;; transitive dependency — and four unactionable lines at the top of every
 ;; build are how people learn to stop reading build output. Saying "allow" is
 ;; only louder-or-quieter: when the JDK finally removes the API the flag will
 ;; not save it, and the failure will be loud and upstream's to fix.
 :jvm-opts ["--sun-misc-unsafe-memory-access=allow"]

 :builds
 {:app
  {:target     :browser
   :output-dir "deploy/core/lighttable"
   :asset-path "."

   ;; The User plugin is a second module rather than a second build: it is
   ;; compiled against this bundle, shares its cljs.core, and is emitted as a
   ;; plain script the plugin loader can load. `npm run build:cljs` copies it
   ;; into the plugin's own directory, which is where load-js resolves from.
   :modules {:bootstrap {:entries [lt.core]}
             :user      {:entries [lt.plugins.user] :depends-on #{:bootstrap}}
             :paredit   {:entries [lt.plugins.paredit] :depends-on #{:bootstrap}}
             ;; Every namespace a plugin's .behaviors file names has to be an
             ;; entry: behaviors are resolved by name at load, so a namespace
             ;; nothing requires is one the module would not contain.
             :clojure   {:entries [lt.plugins.clojure
                                   lt.plugins.clojure.nrepl
                                   lt.plugins.clojure.collapsible-exception]
                         :depends-on #{:bootstrap}}
             :javascript {:entries [lt.plugins.js lt.plugins.js.node]
                          :depends-on #{:bootstrap}}
             :css        {:entries [lt.plugins.css] :depends-on #{:bootstrap}}
             :html       {:entries [lt.plugins.html] :depends-on #{:bootstrap}}
             :python     {:entries [lt.plugins.python] :depends-on #{:bootstrap}}}

   ;; npm packages are bundled rather than required at runtime. The window is
   ;; losing `require` when contextIsolation goes on, so anything it needs has
   ;; to be in the bundle by then; :shadow is shadow-cljs's normal mode.
   ;; Runtime dependencies live in deploy/core/node_modules, next to what ships;
   ;; the root tree is build tooling. Shadow looks in the root by default.
   :js-options {:js-provider :shadow
                :js-package-dirs ["deploy/core/node_modules" "node_modules"]
                ;; web-tree-sitter is emscripten output: one module that branches
                ;; on `ENVIRONMENT_IS_NODE` at runtime and therefore mentions
                ;; `require("fs")` in a branch the window never takes. A bundler
                ;; resolves that statically and fails. Pointing it at an empty
                ;; module is the honest answer — the window has no filesystem,
                ;; it has lt.util.bridge.files.
                :resolve {"fs" {:target :file
                                :file "src-window/fs-stub-shim.js"}
                          "fs/promises" {:target :file
                                         :file "src-window/fs-stub-shim.js"}}}

   :compiler-options {:optimizations  :simple
                      :pretty-print   true
                      :process-shim   false
                      ;; lt.util.cljs extends js/String and js/Array on
                      ;; purpose: it is what makes ("key" some-map) work, and
                      ;; that is published API rather than an accident.
                      :warnings {:extending-base-js-type false}
                      ;; Light Table's plugin API is the global lt.* namespaces,
                      ;; and LightTable.html calls lt.objs.app.init() directly,
                      ;; so the bundle cannot be wrapped in a closure.
                      :output-wrapper false}}

  ;; The worker thread. Compiled rather than assembled from strings at runtime,
  ;; so its contents are visible to the compiler like everything else.
  :worker
  {:target    :node-script
   :main      lt.background.worker/main
   :output-to "deploy/core/lighttable/background/worker.js"

   ;; :shadow rather than the node target's usual :require, for the same reason
   ;; the app build uses it: the worker's own JavaScript is compiled from
   ;; src-worker into src-gen/lt/background, and a runtime require would be
   ;; resolved against the output file's directory rather than the source path.
   ;; Node's own builtins stay external.
   :js-options {:js-provider :shadow
                :js-package-dirs ["deploy/core/node_modules" "node_modules"]
                :keep-as-require #{"fs" "path"}}

   :compiler-options {:optimizations :simple
                      :pretty-print  true}}

  ;; The analysis caches that let the editor compile ClojureScript inside
  ;; itself — see doc/live-editing.md. This emits no code the editor runs:
  ;; every namespace here is already in the bundle above. What it emits is
  ;; ana/<ns>.transit.json, the compiler's knowledge of each namespace, which
  ;; is what a compiler needs to resolve `lt.objs.editor/->val` to the function
  ;; the running window is already holding.
  ;;
  ;; Requiring shadow.cljs.bootstrap.browser from the app build is what makes
  ;; that split work: shadow appends a set_loaded call listing everything the
  ;; bundle provides, and the loader then fetches analysis for those and skips
  ;; their JavaScript. Loading the JavaScript would re-run every top-level def
  ;; and swap out the atoms the running editor is holding.
  :bootstrap
  {:target     :bootstrap
   :output-dir "deploy/core/lighttable/cljs-cache"
   ;; lt.core reaches the editor; the plugins are separate module roots and
   ;; nothing requires them.
   :entries    [lt.core lt.plugins.user lt.plugins.paredit lt.plugins.clojure
                lt.plugins.js lt.plugins.css lt.plugins.html lt.plugins.python]
   ;; Plugin source is mostly behaviors, and `behavior` is a macro. Without
   ;; this, the first form anyone evaluates in a plugin fails to compile.
   :macros     [lt.macros]

   ;; The compiler's own macros, which cannot be self-hosted: cljs.js's macro
   ;; namespace requires cljs.env.macros, and that one exists only as .clj.
   ;; Nothing anyone evaluates in this editor needs to macroexpand the
   ;; compiler, and lt.core reaches it only because lt.objs.cljs-compiler is
   ;; what runs it.
   :exclude    #{cljs.js}

   ;; The same npm resolution as the app build. This target does not inherit
   ;; it, and without it the walk stops at the first `(:require ["codemirror"])`.
   :js-options {:js-provider :shadow
                :js-package-dirs ["deploy/core/node_modules" "node_modules"]
                :resolve {"fs" {:target :file
                                :file "src-window/fs-stub-shim.js"}
                          "fs/promises" {:target :file
                                         :file "src-window/fs-stub-shim.js"}}}

   ;; This build compiles the same sources as :app plus ClojureScript's own
   ;; compiler, and its output is analysis data rather than code anything runs.
   ;; :app is the build that polices our source — it is warning-free and stays
   ;; that way — so what is left here is upstream telling us about upstream:
   ;;
   ;;   :extending-base-js-type   lt.util.cljs extends js/String and js/Array
   ;;                             on purpose, and :app already says so
   ;;   :redef                    cljs.core$macros redefines names from
   ;;                             cljs.core, which is what a macro namespace
   ;;                             compiled for self-hosting does
   ;;   :undeclared-var           cljs/analyzer/api.cljc reads `clojure`,
   ;;                             `java` and `class`, none of which exist in
   ;;                             ClojureScript. Reachable only because
   ;;                             lt.objs.cljs-compiler runs cljs.js.
   ;;
   ;; Nine warnings nobody can act on train people to skim a build log, so they
   ;; are named and silenced rather than tolerated.
   :compiler-options {:optimizations :simple
                      :warnings {:extending-base-js-type false
                                 :redef false
                                 :undeclared-var false}}}

  ;; Runs under node, so only namespaces that load without a DOM or an Electron
  ;; runtime can be exercised here. Anything needing the real app is covered by
  ;; script/smoke-test.js instead.
  :test
  {:target    :node-test
   :output-to "target/test.js"
   :ns-regexp "-test$"}}}
