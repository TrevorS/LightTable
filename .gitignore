# Playwright, which writes these on a failing run.
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# The pinned clj-kondo binary, fetched by script/fetch-clj-kondo.js.
/.tools/

# Storybook outputs: the ClojureScript bundle it renders from, the story files
# generated from lt.ui.story/registry, and the static build. None of the three
# is a decision anyone made — every one is produced by `npm run
# storybook:build`, so committing them would only create something that can go
# stale. Contrast doc/api, which is generated and committed because people read
# it on GitHub.
/.storybook/generated/
/.storybook/stories/
/storybook-static/

# The pinned ripgrep binary, fetched by script/fetch-ripgrep.mts. Unlike
# clj-kondo above this one *ships* — it is copied into the packaged application
# — and the policy is the same either way: source in the repository, no binaries
# in it. `make deps` fetches it; a checkout without it still searches, through
# the tree walk lt.background.search falls back to.
/deploy/core/bin/
