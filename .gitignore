/.lsp/.cache/
/src-gen/
/deploy/plugins/
/plugins/*/*_compiled.js
/plugins/*/*_compiled.js.map
# Third-party npm packages a plugin depends on, installed at build time by
# script/install-plugin-deps.js.
/plugins/*/node_modules/
# Leiningen writes here when it starts a REPL with no project around it.
/plugins/Clojure/local-project/target/
/deploy/core/lighttable/paredit.js
/deploy/core/lighttable/clojure.js
/deploy/core/lighttable/javascript.js
/deploy/core/lighttable/css.js
/deploy/core/lighttable/html.js
/deploy/core/lighttable/python.js
.DS_Store
.lein-deps-sum
.lein-env
.lein-plugins/
.nrepl-port
/builds/
