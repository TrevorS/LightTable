# No dependency of this package runs code at install time.
#
# The sixteen tree-sitter grammars are the only ones that ask to — every one of
# them declares `install: node-gyp-build`, which resolves or compiles a native
# binding. Light Table never loads that binding: grammars are read as `.wasm`
# through web-tree-sitter (see src-window/treesitter.ts), and the `.wasm` comes
# out of the tarball rather than out of the install script.
#
# `package.json` used to carry an `allowScripts` map listing exactly those
# sixteen as `false`. npm has no such key — it is @lavamoat/allow-scripts'
# convention and that tool is not installed here — so the map asserted a
# protection that was not happening. This is the same intent, enforced.
ignore-scripts=true
