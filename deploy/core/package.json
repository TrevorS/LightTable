{
  "name": "LightTable",
  "description": "LightTable Electron App",
  "version": "0.9.0",
  "main": "main.js",
  "browserWindowOptions": {
    "icon": "img/lticon.png",
    "width": 1024,
    "height": 700,
    "minWidth": 400,
    "minHeight": 400,
    "webPreferences": {
      "webgl": true,
      "webaudio": true,
      "plugins": true,
      "nodeIntegration": true,
      "contextIsolation": false
    }
  },
  "dependencies": {
    "codemirror": "^5.65.21",
    "replace": "^1.2.2",
    "socket.io": "^4.8.3",
    "tar": "^7.5.22"
  },
  "forkedDependencies": {}
}
