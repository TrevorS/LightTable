{
  "name": "LightTable",
  "description": "LightTable Electron App",
  "version": "0.9.0",
  "main": "main.js",
  "browserWindowOptions": {
    "icon": "img/lticon.png",
    "width": 1024,
    "height": 700,
    "minWidth": 400,
    "minHeight": 400,
    "webPreferences": {
      "webgl": true,
      "webaudio": true,
      "plugins": true,
      "webviewTag": true,
      "nodeIntegration": false,
      "contextIsolation": true,
      "sandbox": false,
      "preload": "preload.js"
    }
  },
  "dependencies": {
    "bencode": "^2.0.3",
    "buffer": "^6.0.3",
    "codemirror": "^5.65.21",
    "events": "^3.3.0",
    "replace": "^1.2.2",
    "shelljs": "^0.10.0",
    "socket.io": "^4.8.3",
    "tar": "^7.5.22"
  },
  "forkedDependencies": {}
}
